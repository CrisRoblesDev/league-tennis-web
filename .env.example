# League Tennis Aventura - Environment Variables

# Stripe sandbox/test keys. Use the secret key (sk_test_...), never the
# publishable key (pk_test_...). Configure real values as runtime secrets in
# Cloudflare Pages; this example file is documentation only.
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_WEBHOOK_SECRET

# GitHub CMS
GITHUB_TOKEN=github_pat_REPLACE_WITH_YOUR_TOKEN
GITHUB_OWNER=CrisRoblesDev
GITHUB_REPO=league-tennis-web
GITHUB_BRANCH=master

# Authentication
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@example.com
